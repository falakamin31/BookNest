# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.

# MongoDB Atlas connection string
# Atlas → your cluster → Connect → Drivers → copy the srv string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/booknest




# Port the API listens on (Render sets this automatically in production)
PORT=8080

# Secret used to sign JWTs — any long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Origin allowed by CORS (set to your deployed frontend URL in production)
CLIENT_URL=http://localhost:5173

# Cloudinary — dashboard at cloudinary.com shows all three
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
